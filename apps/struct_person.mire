import std

struct Person {
    name :str
    age :i64
    active :bool
}

pub fn main: () {
    set person = (Person name: "Alice", age: 30, active: true)
    use dasu(name: {person.name})
    use dasu(age: {person.age})
    use dasu(active: {person.active})
    
    set age2 = person.age
    set new_age = age2 + 1
    use dasu(next year: {new_age})
}