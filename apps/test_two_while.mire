import lists as lists
import math as math

pub fn main: () {
set xs = [] :vec![i64] mut
set xs = lists.push(xs 1)
set xs = lists.push(xs 2)
set xs = lists.push(xs 3)

set i = 0 :i64 mut
while i < len(xs) {
set x = lists.get(xs i)
use dasu(Item {x})
set i = i + 1
}
set sum = 0 :i64 mut
set j = 0 :i64 mut
while j < len(xs) {
set v = lists.get(xs j)
set sum = sum + v
set j = j + 1
}
use dasu(Total {sum})
}