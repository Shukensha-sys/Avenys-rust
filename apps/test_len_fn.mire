import lists as lists

fn double_len: (xs:vec[i64]) :i64 {
set l = len(xs)
return l
}
pub fn main: () {
set xs = [] :vec[i64] mut
set xs = lists.push(xs 100)
set xs = lists.push(xs 200)
set xs = lists.push(xs 300)

set l1 = double_len(xs)
set l2 = double_len(xs)
set l3 = double_len(xs)

use dasu("l1 {l1}")
use dasu("l2 {l2}")
use dasu("l3 {l3}")
}