import lists as lists
import math as math

fn sum_list: (xs:vec![i64]) :i64 {
set total = 0 :i64 mut
set i = 0 :i64 mut
while i < len(xs) {
set v = lists.get(xs i)
set total = total + v
set i = i + 1
}
return total
}
pub fn main: () {
set xs = [] :vec![i64] mut
set xs = lists.push(xs 10)
set xs = lists.push(xs 20)
set xs = lists.push(xs 30)

set total = sum_list(xs)
use dasu(Total {total})
}