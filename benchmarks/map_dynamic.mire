import time as time
import mem as mem
import cpu as cpu
import dicts as dicts
import math as math

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set counts = [] :map[str i64] mut

set i = 0 :i64 mut
while i < 5000 {
    set key = "item" + str(i % 100)
    set current = dicts.get(counts key 0)
    set counts = dicts.set(counts key current + 1)
    set i += 1
}
set keys = dicts.keys(counts)
set result = math.sum(dicts.values(counts))

use dasu("total_keys {len(keys")})
use dasu("total_values {result}")
use dasu("wall_ms {time.elapsed_ms(wall")})
use dasu("cpu_ms {cpu.elapsed_ms(proc")})
use dasu("process_ram {mem.format(mem.process("))})
