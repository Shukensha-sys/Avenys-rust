import time as time
import mem as mem
import cpu as cpu
import strings as strings

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set text = "Hello World" :str mut
set result = "" :str mut

set i = 0 :i64 mut
while i < 10000 {
    set result = strings.to_upper(text)
    set result = strings.to_lower(result)
    set result = strings.replace(result "world" "mire")
    set i += 1
}
use dasu(result {result})
use dasu(len {len(result)})
use dasu(wall_ms {time.elapsed_ms(wall)})
use dasu(cpu_ms {cpu.elapsed_ms(proc)})
use dasu(process_ram {mem.format(mem.process())})
