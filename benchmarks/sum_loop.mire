import time as time
import mem as mem

set mark = time.mark() :i64 mut
set limit = 1000000 :i64 mut
set i = 0 :i64 mut
set acc = 0 :i64 mut

while i < limit {
    set acc += i
    set i += 1
}
use dasu(result {acc})
use dasu(elapsed_ms {time.elapsed_ms(mark)})
use dasu(process_ram {mem.format(mem.process())})
