import time as time
import mem as mem
import cpu as cpu
import lists as lists

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set flags = []  :vec[bool] mut
set i = 0 :i64 mut

while i < 20000 {
    set flags = lists.push(flags i % 2 == 0)
    set i += 1
}
set total = 0 :i64 mut
set j = 0 :i64 mut
while j < len(flags) {
    if lists.get(flags j) {
        set total += 1
    }
    set j += 1
}
use dasu("total {total}")
use dasu("items {len(flags")})
use dasu("first {str(lists.get(flags 0"))})
use dasu("last {str(lists.get(flags 19999"))})
use dasu("wall_ms {time.elapsed_ms(wall")})
use dasu("cpu_ms {cpu.elapsed_ms(proc")})
use dasu("cpu_cycles_est {cpu.cycles_est(proc")})
use dasu("process_ram {mem.format(mem.process("))})
