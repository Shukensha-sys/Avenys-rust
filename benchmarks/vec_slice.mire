import time as time
import mem as mem
import cpu as cpu
import lists as lists
import math as math

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set data = []  :vec![i64] mut

set i = 0 :i64 mut
while i < 5000 {
    set data = lists.push(data i)
    set i += 1
}
set half = len(data) / 2 :i64 mut
set sliced = lists.slice(data 0 half)
set sum_all = math.sum(data)
set sum_sliced = math.sum(sliced)

use dasu(sum_all {sum_all})
use dasu(sum_sliced {sum_sliced})
use dasu(sliced_len {len(sliced)})
use dasu(wall_ms {time.elapsed_ms(wall)})
use dasu(cpu_ms {cpu.elapsed_ms(proc)})
