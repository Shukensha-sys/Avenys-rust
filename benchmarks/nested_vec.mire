import time as time
import mem as mem
import cpu as cpu

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set matrix = []  :vec![vec![i64]] mut

set i = 0 :i64 mut
while i < 100 {
    set row = []  :vec![i64] mut
    set j = 0 :i64 mut
    while j < 100 {
        set row = row + [i * 100 + j]
        set j += 1
    }
    set matrix = matrix + [row]
    set i += 1
}
set total = 0 :i64 mut
set i = 0 :i64 mut
while i < 100 {
    set j = 0 :i64 mut
    while j < 100 {
        set idx = i * 100 + j
        set total += idx
        set j += 1
    }
    set i += 1
}
use dasu("total {total}")
use dasu("rows {len(matrix")})
use dasu("wall_ms {time.elapsed_ms(wall")})
use dasu("cpu_ms {cpu.elapsed_ms(proc")})
use dasu("process_ram {mem.format(mem.process("))})
