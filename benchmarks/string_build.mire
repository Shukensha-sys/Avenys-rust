import time as time
import mem as mem

set mark = time.mark() :i64 mut
set limit = 20000 :i64 mut
set i = 0 :i64 mut
set out = "seed" :str mut

while i < limit {
    set out = out + "-x"
    set i += 1
}
use dasu(length {len(out)})
use dasu(elapsed_ms {time.elapsed_ms(mark)})
use dasu(process_ram {mem.format(mem.process())})
