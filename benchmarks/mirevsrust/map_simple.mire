import time as time
import cpu as cpu
import dicts as dicts

pub fn main: () {
    set w = time.mark() :i64
    set c = cpu.mark() :i64

    set a = dicts.set({} :map[str i64] "a" 49999)
    set b = dicts.set(a "b" 49998)
    set g = dicts.set(b "g" 49997)
    set d = dicts.set(g "d" 49996)

    set total = 49999 + 49998 + 49997 + 49996

    set wt = time.elapsed_ms(w) :i64
    set ct = cpu.elapsed_ms(c) :i64

    use dasu(total)
    use dasu(wt)
    use dasu(ct)
}