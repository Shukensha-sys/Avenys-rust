import time as time
import mem as mem
import cpu as cpu
import lists as lists
import math as math

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set xs = []  :vec![i32] mut
set i = 0 :i64 mut

while i < 30000 {
    set xs = lists.push(xs i)
    set i += 1
}
set total = math.sum(xs)
set first = lists.get(xs 0) :i32 mut
set mid = lists.get(xs 15000) :i32 mut
set last = lists.get(xs 29999) :i32 mut

use dasu(total {total})
use dasu(items {len(xs)})
use dasu(first {first})
use dasu(mid {mid})
use dasu(last {last})
use dasu(wall_ms {time.elapsed_ms(wall)})
use dasu(cpu_ms {cpu.elapsed_ms(proc)})
use dasu(cpu_cycles_est {cpu.cycles_est(proc)})
use dasu(process_ram {mem.format(mem.process())})
