import time as time
import mem as mem
import cpu as cpu
import dicts as dicts

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set labels = [] :map[bool str] mut
set labels = dicts.set(labels true enabled) mut
set labels = dicts.set(labels false disabled) mut

set total = 0 :i64 mut
set i = 0 :i64 mut
while i < 40000 {
    set on = dicts.get(labels true "")
    set off = dicts.get(labels false "")
    set total += len(on)
    set total += len(off)
    set i += 1
}
use dasu("total {total}")
use dasu("labels {str(labels")})
use dasu("wall_ms {time.elapsed_ms(wall")})
use dasu("cpu_ms {cpu.elapsed_ms(proc")})
use dasu("cpu_cycles_est {cpu.cycles_est(proc")})
use dasu("process_ram {mem.format(mem.process("))})
