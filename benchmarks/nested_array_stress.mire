import time as time
import mem as mem
import cpu as cpu

set wall = time.mark() :i64 mut
set proc = cpu.mark() :i64 mut
set base0 = [1 2 3 4] :arr[i64 4]
set base1 = [5 6 7 8] :arr[i64 4]
set base2 = [9 10 11 12] :arr[i64 4]
set matrix = [base0 base1 base2] :arr[arr[i64 4] 3]

set rows = len(matrix)
set row0 = matrix at 0 :arr[i64 4]
set row1 = matrix at 1 :arr[i64 4]
set row2 = matrix at 2 :arr[i64 4]
set cols = len(row0)
set total = 0 :i64 mut
set total += row0 at 0
set total += row0 at 1
set total += row0 at 2
set total += row0 at 3
set total += row1 at 0
set total += row1 at 1
set total += row1 at 2
set total += row1 at 3
set total += row2 at 0
set total += row2 at 1
set total += row2 at 2
set total += row2 at 3
set edge = row2 at 3

use dasu(rows {rows})
use dasu(cols {cols})
use dasu(total {total})
use dasu(edge {edge})
use dasu(wall_ms {time.elapsed_ms(wall)})
use dasu(cpu_ms {cpu.elapsed_ms(proc)})
use dasu(cpu_cycles_est {cpu.cycles_est(proc)})
use dasu(process_ram {mem.format(mem.process())})
