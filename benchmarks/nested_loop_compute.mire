import time as time
import mem as mem
import cpu as cpu

set wall = time.mark() :i64 mut

set total = 0 :i64 mut
set i = 0 :i64 mut
while i < 100 {
    set j = 0 :i64 mut
    while j < 100 {
        set val = i * 100 + j
        set total += val
        set j += 1
    }
    set i += 1
}
use dasu(total {total})
use dasu(wall_ms {time.elapsed_ms(wall)})
