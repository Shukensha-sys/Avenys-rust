# ================================================================================
# STD.MIRE - Standard Library de Mire
# ================================================================================
# Este archivo define las funciones estándar disponibles en Mire.
# Secciona por categoría para facilitar la navegación y mantenimiento.
# ================================================================================

# ============================================
# MATH - Funciones Matemáticas
# ============================================
# Funciones básicas de math

pub fn abs: (n :i64) :i64
pub fn min: (a :i64, b :i64) :i64
pub fn max: (a :i64, b :i64) :i64
pub fn sum: (list) :i64
pub fn clamp: (n :i64, min :i64, max :i64) :i64
pub fn range: (end :i64) :vec![i64]
pub fn round: (n :f64) :i64
pub fn floor: (n :f64) :i64
pub fn ceil: (n :f64) :i64

# ============================================
# LISTS - Operaciones con Listas
# ============================================
# Manipulación de listas y vectores

pub fn len: (list) :i64
pub fn push: (list, value)
pub fn pop: (list) :i64
pub fn append: (list, value)
pub fn remove: (list, index :i64)
pub fn delete: (list, index :i64)
pub fn clear: (list)
pub fn join: (list, sep :str) :str
pub fn contains: (list, value) :bool
pub fn index_of: (list, value) :i64
pub fn first: (list) :i64
pub fn last: (list) :i64
pub fn slice: (list, start :i64, end :i64) :vec![i64]
pub fn concat: (list, other :vec![i64]) :vec![i64]
pub fn flatten: (list :vec![vec![i64]]) :vec![i64]
pub fn reverse: (list)
pub fn sort: (list)
pub fn unique: (list) :vec![i64]
pub fn is_empty: (list) :bool

# LISTS.HOF - Higher Order Functions
pub fn map: (list, func)
pub fn filter: (list, func)
pub fn fold: (acc :i64, list, func) :i64

# ============================================
# STRINGS - Operaciones con Strings
# ============================================
# Manipulación de cadenas de texto

pub fn upper: (s :str) :str
pub fn lower: (s :str) :str
pub fn strip: (s :str) :str
pub fn split: (s :str, sep :str) :vec![str]
pub fn replace: (s :str, old :str, new :str) :str
pub fn contains: (s :str, sub :str) :bool
pub fn startswith: (s :str, prefix :str) :bool
pub fn endswith: (s :str, suffix :str) :bool
pub fn len: (s :str) :i64
pub fn trim: (s :str) :str
pub fn ltrim: (s :str) :str
pub fn rtrim: (s :str) :str
pub fn substr: (s :str, start :i64, len :i64) :str
pub fn pad_left: (s :str, len :i64, pad :str) :str
pub fn pad_right: (s :str, len :i64, pad :str) :str
pub fn repeat: (s :str, n :i64) :str
pub fn is_empty: (s :str) :bool

# ============================================
# DICTS - Operaciones con Diccionarios
# ============================================
# Manipulación de mapas/diccionarios

pub fn len: (dict) :i64
pub fn keys: (dict) :vec![str]
pub fn values: (dict) :vec![i64]
pub fn has: (dict, key :str) :bool
pub fn get: (dict, key :str) :i64
pub fn set: (dict, key :str, value :i64)
pub fn remove: (dict, key :str)
pub fn delete: (dict, key :str)
pub fn entries: (dict) :vec![i64]
pub fn merge: (dict, other)
pub fn is_empty: (dict) :bool

# ============================================
# TIME - Funciones de Tiempo
# ============================================
# Medición y control de tiempo

pub fn unix_ms: () :i64
pub fn unix_ns: () :i64
pub fn since_ms: (start :i64) :i64
pub fn since_ns: (start :i64) :i64
pub fn mark: () :i64
pub fn elapsed: (mark :i64) :i64
pub fn elapsed_ms: (mark :i64) :i64
pub fn elapsed_ns: (mark :i64) :i64
pub fn sleep_ms: (ms :i64)
pub fn sleep_ns: (ns :i64)

# ============================================
# TERM - Funciones de Terminal
# ============================================
# Utilidades para terminal

pub fn style: (s :str, style :str) :str
pub fn hr: (char :str, len :i64) :str
pub fn clear: () :str

# ============================================
# MEM - Funciones de Memoria
# ============================================
# Información de memoria del sistema

pub fn used: () :i64
pub fn total: () :i64
pub fn free: () :i64
pub fn available: () :i64
pub fn percent: () :i64
pub fn process: () :i64
pub fn snapshot: () :map[str i64]
pub fn format: (bytes :i64) :str

# ============================================
# CPU - Funciones de CPU
# ============================================
# Información de CPU del sistema

pub fn time_ns: () :i64
pub fn time_ms: () :i64
pub fn mark: () :i64
pub fn elapsed: (mark :i64) :i64
pub fn elapsed_ms: (mark :i64) :i64
pub fn elapsed_ns: (mark :i64) :i64
pub fn count: () :i64
pub fn freq_mhz: () :i64
pub fn cycles_est: (mark :i64) :i64
pub fn loadavg: () :vec![f64]
pub fn snapshot: () :map[str i64]

# ============================================
# GPU - Funciones de GPU
# ============================================
# Información de GPU del sistema

pub fn available: () :bool
pub fn snapshot: () :map[str i64]

# ============================================
# FS - Funciones del Sistema de Archivos
# ============================================
# Operaciones con archivos y directorios

pub fn read: (path :str) :str
pub fn write: (path :str, data :str)
pub fn append: (path :str, data :str)
pub fn exists: (path :str) :bool
pub fn size: (path :str) :i64
pub fn copy: (src :str, dst :str)
pub fn move: (src :str, dst :str)
pub fn drop: (path :str)
pub fn list: (path :str) :vec![str]
pub fn mkdir: (path :str)
pub fn rmdir: (path :str)
pub fn join: (a :str, b :str) :str
pub fn dir: (path :str) :str
pub fn name: (path :str) :str
pub fn ext: (path :str) :str

# ============================================
# ENV - Variables de Entorno
# ============================================
# Acceso a variables de entorno

pub fn get: (key :str) :str
pub fn set: (key :str, value :str)
pub fn all: () :map[str str]
pub fn args: () :vec![str]
pub fn cwd: () :str
pub fn chdir: (path :str)

# ============================================
# PROC - Funciones de Procesos
# ============================================
# Ejecución y control de procesos

pub fn run: (cmd :str, args :vec![str]) :i64
pub fn spawn: (cmd :str, args :vec![str]) :i64
pub fn pipe: (commands :vec![str]) :str
pub fn shell: (cmd :str) :str
pub fn read: () :str
pub fn write: (data :str)
pub fn on: (signal :str, handler)
pub fn exit: (code :i64)
pub fn err: () :str
pub fn exec: (cmd :str, args :vec![str]) :i64
pub fn exec_bg: (cmd :str, args :vec![str]) :i64
pub fn kill: (pid :i64)
pub fn wait: (pid :i64) :i64
pub fn exists: (pid :i64) :bool