# ==============================================================================
# STD.MIRE - Aggregator de Standard Library de Mire
# ==============================================================================
# Este archivo mantiene compatibilidad con `import std` y delega la definición
# modular a `src/modules/std/<seccion>/mod.mire`.
# ==============================================================================

import ./src/modules/std/math/mod
import ./src/modules/std/lists/mod
import ./src/modules/std/strings/mod
import ./src/modules/std/dicts/mod
import ./src/modules/std/time/mod
import ./src/modules/std/term/mod
import ./src/modules/std/mem/mod
import ./src/modules/std/cpu/mod
import ./src/modules/std/gpu/mod
import ./src/modules/std/fs/mod
import ./src/modules/std/env/mod
import ./src/modules/std/proc/mod
