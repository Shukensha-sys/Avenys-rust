pub fn abs: (x: i64) :i64 {
    if x < 0 { return -x } else { return x }
}

pub fn min: (a: i64, b: i64) :i64 {
    if a < b { return a } else { return b }
}

pub fn max: (a: i64, b: i64) :i64 {
    if a > b { return a } else { return b }
}

pub fn clamp: (x: i64, lo: i64, hi: i64) :i64 {
    if x < lo { return lo } elif x > hi { return hi } else { return x }
}

pub fn sum: (list: vec[i64]) :i64 {
    set out = 0 mut
    for v in list {
        set out += v
    }
    return out
}

pub fn avg: (list: vec[i64]) :i64 {
    set s = 0 mut
    set n = 0 mut
    for v in list {
        set s += v
        set n += 1
    }
    if n == 0 { return 0 }
    return s / n
}

pub fn lerp: (a: i64, b: i64, t: i64) :i64 {
    return a + (b - a) * t
}

pub fn sign: (x: i64) :i64 {
    if x > 0 { return 1 } elif x < 0 { return -1 } else { return 0 }
}

pub fn is_even: (x: i64) :bool {
    return x % 2 == 0
}

pub fn is_odd: (x: i64) :bool {
    return x % 2 == 1
}

pub fn round: (x: f64) :i64 {
    return round(x)
}

pub fn floor: (x: f64) :i64 {
    return floor(x)
}

pub fn ceil: (x: f64) :i64 {
    return ceil(x)
}
