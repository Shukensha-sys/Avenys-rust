load kioto

extern fn rt_lists_push_i64: (list, value :i64) :vec[i64] lib "c"

pub fn main: () {
    set K = [] :vec[i64] mut
    set K = rt_lists_push_i64(K, 4794697086780616226)
    set K = rt_lists_push_i64(K, 8158064640168781261)
    set K = rt_lists_push_i64(K, -5349999486874862801)

    set v0 = lists::get(K, 0)
    set v1 = lists::get(K, 1)
    set v2 = lists::get(K, 2)

    dasu("K[0] = {v0}  (expected 4794697086780616226)")
    dasu("K[1] = {v1}  (expected 8158064640168781261)")
    dasu("K[2] = {v2}  (expected -5349999486874862801)")

    set ok0 = v0 == 4794697086780616226
    set ok1 = v1 == 8158064640168781261
    set ok2 = v2 == -5349999486874862801

    if ok0 && ok1 && ok2 {
        dasu("ALL OK - push workaround works correctly")
    } else {
        dasu("BUG: push workaround also corrupts!")
    }
}
