load kioto

pub fn main: () {
    // Reproduce list literal corruption: 3+ large i64 values > ~2^62
    // Values taken from SHA-512 K constants
    set K = [4794697086780616226 8158064640168781261 -5349999486874862801] :vec[i64]

    set v0 = lists::get(K, 0)
    set v1 = lists::get(K, 1)
    set v2 = lists::get(K, 2)

    dasu("K[0] = {v0}  (expected 4794697086780616226)")
    dasu("K[1] = {v1}  (expected 8158064640168781261)")
    dasu("K[2] = {v2}  (expected -5349999486874862801)")

    set ok0 = v0 == 4794697086780616226
    set ok1 = v1 == 8158064640168781261
    set ok2 = v2 == -5349999486874862801

    if ok0 && ok1 && ok2 {
        dasu("ALL OK - list literal works correctly")
    } else {
        dasu("BUG: list literal corruption detected!")
    }
}
