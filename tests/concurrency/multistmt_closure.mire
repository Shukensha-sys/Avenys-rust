// Test: multi-statement closure body, with captures, via thread::spawn/thread::join.
load kioto

pub fn main: () {
    set data = 100 :i64
    set task = () => {
        use dasu("in thread")
        set x = data + 1
        x * 2
    }
    set tid = thread::spawn(task)
    set ret = thread::join(tid)
    use dasu("thread result: " + str(ret))
}
