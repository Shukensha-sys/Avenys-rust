// Test: spawn multiple independent threads and sum their deterministic results.
load kioto

pub fn main: () {
    set tasks = 4 :i64
    set i = 0 :i64 mut
    set sum = 0 :i64 mut
    while i < tasks {
        // Capture a copy of the loop index so the mutable variable can advance.
        set idx = i
        set t = thread::spawn(() => {
            set base = idx + 1
            base * 10
        })
        set partial = thread::join(t)
        set sum = sum + partial
        set i = i + 1
    }
    use dasu("sum: " + str(sum))
}
