{
  "name": "mire-language",
  "displayName": "Mire Language",
  "description": "Advanced language support for Mire and Owl projects",
  "version": "1.1.0",
  "publisher": "mire",
  "author": "Mire Team",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/mire"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "mire",
    "owl",
    "language",
    "compiler",
    "ownership"
  ],
  "activationEvents": [
    "onLanguage:mire",
    "workspaceContains:**/owl.toml",
    "onCommand:mire.runFile",
    "onCommand:mire.checkFile",
    "onCommand:mire.buildProject",
    "onCommand:mire.owlRun",
    "onCommand:mire.owlBuild"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mire",
        "aliases": [
          "Mire",
          "mire"
        ],
        "extensions": [
          ".mire"
        ],
        "filenames": [],
        "firstLine": "^import std",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mire",
        "scopeName": "source.mire",
        "path": "./syntaxes/mire.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mire",
        "path": "./snippets/mire.code-snippets"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Mire",
      "properties": {
        "mire.runtimePath": {
          "type": "string",
          "default": "mire",
          "description": "Path to Mire binary"
        },
        "mire.owlPath": {
          "type": "string",
          "default": "owl",
          "description": "Path to Owl binary"
        },
        "mire.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run .mire files on save"
        },
        "mire.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable fast in-editor diagnostics"
        },
        "mire.useCompilerCheck": {
          "type": "boolean",
          "default": false,
          "description": "Run `mire check` to enrich diagnostics (slower)"
        }
      }
    },
    "commands": [
      {
        "command": "mire.runFile",
        "title": "Mire: Run File",
        "category": "Mire"
      },
      {
        "command": "mire.checkFile",
        "title": "Mire: Check File",
        "category": "Mire"
      },
      {
        "command": "mire.buildProject",
        "title": "Mire: Build Project",
        "category": "Mire"
      },
      {
        "command": "mire.owlRun",
        "title": "Owl: Run Project",
        "category": "Owl"
      },
      {
        "command": "mire.owlBuild",
        "title": "Owl: Build Project",
        "category": "Owl"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mire.owlRun",
          "when": "mire.isOwlProject"
        },
        {
          "command": "mire.owlBuild",
          "when": "mire.isOwlProject"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
